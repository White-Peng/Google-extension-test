{
  "manifest_version": 4,
  "name": "YouTube Learning Reflection Companion",
  "version": "0.1.0",
  "description": "Surface insights from recent YouTube learning videos and generate flashcards for reflection.",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "history",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*"
  ],
  "options_page": "src/options.html"
}
